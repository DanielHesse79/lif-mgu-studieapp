# Anthropic API-nyckel – används ENDAST på serversidan (serverless-funktion /api/claude).
# Notera: INGET VITE_-prefix, så nyckeln bundlas aldrig in i webbläsarkoden.
#
# Lokalt:  kopiera denna fil till .env.local och fyll i din nyckel.
# Vercel:  lägg till ANTHROPIC_API_KEY under Project Settings → Environment Variables.
ANTHROPIC_API_KEY=sk-ant-...

# Valfritt: modell som används. Default är claude-sonnet-4-6.
CLAUDE_MODEL=claude-sonnet-4-6
